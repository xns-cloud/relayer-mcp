{
  "name": "@xns-cloud/relayer-mcp",
  "mcpName": "tech.xns/relayer",
  "version": "0.9.3",
  "description": "MCP server for XNS Relayer onboarding and day-2 management — drives Relayer setup, settings, and backups conversationally over stdio, npx-ready",
  "author": "SCP Corp",
  "license": "Apache-2.0",
  "homepage": "https://xns.tech",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/scpcorp/relayer-mcp.git"
  },
  "bugs": {
    "url": "https://gitlab.com/scpcorp/relayer-mcp/-/issues"
  },
  "bin": {
    "relayer-mcp": "src/index.js"
  },
  "scripts": {
    "test": "jest --verbose",
    "start": "node src/index.js",
    "prepublishOnly": "npm test",
    "bundle:validate": "mcpb validate manifest.json",
    "bundle": "npm ci --omit=dev && mcpb validate manifest.json && mcpb pack"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "relayer",
    "xns",
    "s3",
    "object-storage",
    "onboarding",
    "ai-agent",
    "stdio",
    "docker",
    "self-hosted",
    "storage",
    "backup",
    "s3-compatible",
    "claude",
    "zero-egress",
    "rag-infrastructure",
    "agentic-workflows",
    "agentic"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/index.js",
    "src/lib/",
    "src/tools/",
    "src/templates/",
    "LICENSE",
    "NOTICE",
    "manifest.json",
    "PRIVACY.md"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testMatch": [
      "**/src/__tests__/**/*.test.js"
    ],
    "testEnvironment": "node",
    "forceExit": true
  }
}
