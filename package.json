{
  "name": "@xns-cloud/relayer-mcp",
  "mcpName": "tech.xns/relayer",
  "version": "0.14.1",
  "description": "S3-compatible cloud object storage from XNS, set up and managed by your AI assistant.",
  "author": "SCP Corp",
  "license": "Apache-2.0",
  "homepage": "https://xns.tech",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/scpcorp/relayer-mcp.git"
  },
  "bugs": {
    "url": "https://gitlab.com/scpcorp/relayer-mcp/-/issues"
  },
  "bin": {
    "relayer-mcp": "src/index.js"
  },
  "scripts": {
    "test": "jest --verbose",
    "start": "node src/index.js",
    "prepublishOnly": "npm test",
    "bundle:validate": "npx --yes @anthropic-ai/mcpb@2.1.2 validate manifest.json",
    "bundle": "npm ci --omit=dev && npx --yes @anthropic-ai/mcpb@2.1.2 validate manifest.json && npx --yes @anthropic-ai/mcpb@2.1.2 pack"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "relayer",
    "xns",
    "s3",
    "object-storage",
    "onboarding",
    "ai-agent",
    "stdio",
    "docker",
    "storage",
    "backup",
    "s3-compatible",
    "claude",
    "zero-egress",
    "rag-infrastructure",
    "agentic-workflows",
    "agentic"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src/index.js",
    "src/lib/",
    "src/tools/",
    "LICENSE",
    "NOTICE",
    "manifest.json",
    "PRIVACY.md"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testMatch": [
      "**/src/__tests__/**/*.test.js"
    ],
    "testEnvironment": "node",
    "forceExit": true
  }
}
